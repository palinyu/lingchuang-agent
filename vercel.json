{
  "functions": {
    "api/generate.js": { "maxDuration": 60 },
    "api/deepseek-copy.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/", "destination": "/zhishi_mofang.html" },
    { "source": "/mofang", "destination": "/zhishi_mofang.html" }
  ],
  "headers": [
    {
      "source": "/zhishi_mofang.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
